<div class="container my-5">
  <div class="row mb-4">
    <div class="col-md-4">
      <h4 class="bg-light px-3 py-2 d-inline-block font-weight-bold mb-4">ジャンル一覧・追加</h4>

      <%= form_with model: [:admin, @genre], local: true do |f| %>
        <div>
          <%= f.label :name, "ジャンル名" %>
          <%= f.text_field :name, placeholder: "ジャンル名" %>
          <%= f.submit "新規登録", class: "btn btn-success" %>
        </div>
      <% end %>

      <table class="table mt-3">
        <thead class="table-light">
          <tr>
            <th>ジャンル</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @genres.each do |genre| %>
            <tr>
              <td><%= genre.name %></td>
              <td>
                <%= link_to "編集する", edit_admin_genre_path(genre), class: "btn btn-success" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
