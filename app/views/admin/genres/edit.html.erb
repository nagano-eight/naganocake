<div class="container my-5">
  <div class="row mb-4">
    <div class="col-md-4">
      <h4 class="bg-light px-3 py-2 d-inline-block font-weight-bold mb-4">ジャンル編集</h4>

      <%= form_with model: [:admin, @genre], local: true do |f| %>
        <div>
          <%= f.label :name, "ジャンル名" %>
          <%= f.text_field :name %>
          <%= f.submit "変更を保存", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>