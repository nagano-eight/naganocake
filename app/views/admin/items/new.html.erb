<div class="container my-5">
  <div class="row mb-4">
    <div class="col-md-8 offset-md-1">
      <h4 class="bg-light px-3 py-2 d-inline-block font-weight-bold mb-4">商品新規登録</h4>

      <%= form_with model: [:admin, @item], local: true do |f| %>
        <div class="form-group">
          <%= f.label :image, "商品画像" %>
          <%= f.file_field :image, class: "form-control-file" %>
        </div>

        <div class="form-group">
          <%= f.label :name, "商品名" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :introduction, "商品説明" %>
          <%= f.text_area :introduction, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :genre_id, "ジャンル" %>
          <%= f.collection_select :genre_id, @genres, :id, :name, { prompt: "-- 選択してください --" }, { class: "form-control" } %>
        </div>

        <div class="form-group">
          <%= f.label :price, "税抜価格" %>
          <div class="d-flex align-items-center">
            <%= f.text_field :price, class: "form-control" %>
            <span class="ms-2">円</span>
          </div>
        </div>

        <div class="form-group">
          <%= f.label :is_active, "販売ステータス" %>
          <%= f.radio_button :is_active, true %> 販売中
          <%= f.radio_button :is_active, false %> 販売停止中
        </div>

        <div class="form-group">
          <%= f.submit "新規登録", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>