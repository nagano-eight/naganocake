<div class="container my-5">
  <div class="row mb-4">
    <div class="col-md-8 offset-md-1">
      <h4 class="bg-light px-3 py-2 d-inline-block font-weight-bold mb-4"><%= @customer.last_name %><%= @customer.first_name %>さんの会員情報編集</h4>

      <%= form_with model: [:admin, @customer], local: true do |f| %>

        <div class="form-group row">
          <label class="col-md-3 col-form-label">会員ID</label>
          <div class="col-md-9 d-flex align-items-center">
            <%= @customer.id %>
          </div>
        </div>

        <div class="form-group row">
          <label class="col-md-3 col-form-label">氏名</label>
          <div class="col-md-9 d-flex mb-2">
            <%= f.text_field :last_name, class: "form-control me-2" %>
            <%= f.text_field :first_name, class: "form-control" %>
          </div>
        </div>

        <div class="form-group row">
          <label class="col-md-3 col-form-label">フリガナ</label>
          <div class="col-md-9 d-flex mb-2">
            <%= f.text_field :last_name_kana, class: "form-control me-2" %>
            <%= f.text_field :first_name_kana, class: "form-control" %>
          </div> 
        </div>

        <div class="form-group row">
          <%= f.label :postal_code, "郵便番号", class: "col-md-3 col-form-label" %>
          <div class="col-md-9 mb-2">
            <%= f.text_field :postal_code, class: "form-control" %>
          </div>
        </div>

        <div class="form-group row">
          <%= f.label :address, "住所", class: "col-md-3 col-form-label" %>
          <div class="col-md-9 mb-2">
            <%= f.text_field :address, class: "form-control" %>
          </div>
        </div>

        <div class="form-group row">
          <%= f.label :telephone_number, "電話番号", class: "col-md-3 col-form-label" %>
          <div class="col-md-9 mb-2">
            <%= f.text_field :telephone_number, class: "form-control" %>
          </div>
        </div>

        <div class="form-group row">
          <%= f.label :email, "メールアドレス", class: "col-md-3 col-form-label" %>
          <div class="col-md-9 mb-2">
            <%= f.text_field :email, class: "form-control w-50" %>
          </div>
        </div>

        <div class="form-group row">
          <label class="col-md-3 col-form-label">会員ステータス</label>
          <div class="col-md-9 d-flex align-items-center">
            <div class="form-check form-check-inline">
              <%= f.radio_button :is_active, true, class: "form-check-input" %>
              <%= f.label :is_active_true, "有効", class: "form-check-label me-3" %>
            </div>
            <div class="form-check form-check-inline">
              <%= f.radio_button :is_active, false, class: "form-check-input" %>
              <%= f.label :is_active_false, "退会", class: "form-check-label me-3" %>
            </div>
          </div>
        </div>

        <div class="form-group row mt-4">
          <div class="col-md-9 offset-md-3">
            <%= f.submit "変更を保存する", class: "btn btn-success" %>
          </div>
        </div>

      <% end %>
    </div>
  </div>
</div>