<div class="container my-5">
  <div class="row mb-4">
    <div class="col-md-8 offset-md-1">
      <h4 class="bg-light px-3 py-2 d-inline-block font-weight-bold mb-4"><%= @customer.last_name %><%= @customer.first_name %>さんの会員情報編集</h4>

      <%= form_with model: [:admin, @customer], local: true do |f| %>

        <div class="form-group">
          <label>会員ID</label>
          <%= @customer.id %>
        </div>

        <div class="form-group">
          <label>氏名</label>
          <%= f.text_field :last_name, class: "form-control" %>
          <%= f.text_field :first_name, class: "form-control" %>
        </div>

        <div class="form-group">
          <label>フリガナ</label>
          <%= f.text_field :last_name_kana, class: "form-control" %>
          <%= f.text_field :first_name_kana, class: "form-control" %>    
        </div>

        <div class="form-group">
          <%= f.label :postal_code, "郵便番号" %>
          <%= f.text_field :postal_code, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :address, "住所" %>
          <%= f.text_field :address, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :telephone_number, "電話番号" %>
          <%= f.text_field :telephone_number, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :email, "メールアドレス" %>
          <%= f.text_field :email, class: "form-control" %>
        </div>

        <div class="form-group">
          <label>会員ステータス</label>
          <%= f.radio_button :is_active, true %>
          <%= f.label :is_active_true, "有効", class: "mr-3" %>
          <%= f.radio_button :is_active, false %>
          <%= f.label :is_active_false, "退会" %>
        </div>

        <div class="form-group mt-4">
          <%= f.submit "変更を保存する", class: "btn btn-success" %>
        </div>

      <% end %>
    </div>
  </div>
</div>