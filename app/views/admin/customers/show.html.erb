<div class="container my-5">
  <div class="row mb-4">
    <div class="col-md-8 offset-md-1">
      <h4 class="bg-light px-3 py-2 d-inline-block font-weight-bold mb-4"><%= @customer.last_name %><%= @customer.first_name %>さんの会員詳細</h4>
    <div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <table class="table table-borderless">
        <tr>
          <th>会員ID</th>
          <td><%= @customer.id %></td>
        </tr>
        <tr>
          <th>氏名</th>
          <td><%= @customer.last_name %> <%= @customer.first_name %></td>
        </tr>
        <tr>
          <th>フリガナ</th>
          <td><%= @customer.last_name_kana %> <%= @customer.first_name_kana %></td>
        </tr>
        <tr>
          <th>郵便番号</th>
          <td><%= @customer.postal_code %></td>
        </tr>
        <tr>
          <th>住所</th>
          <td><%= @customer.address %></td>
        </tr>
        <tr>
          <th>電話番号</th>
          <td><%= @customer.telephone_number %></td>
        </tr>
        <tr>
          <th>メールアドレス</th>
          <td><%= @customer.email %></td>
        </tr>
        <tr>
          <th>会員ステータス</th>
          <td>
            <% if @customer.is_active? %>
              <span class="text-success font-weight-bold">有効</span>
            <% else %>
              <span class="text-secondary font-weight-bold">退会</span>
            <% end %>
          </td>
        </tr>
      </table>

      <div class="mt-4">
        <%= link_to "編集する", edit_admin_customer_path(@customer), class: "btn btn-success mr-2" %>
        <%= link_to "注文履歴一覧を見る", admin_root_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>
</div>