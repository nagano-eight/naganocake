<div class="container my-5">
  <div class="row mb-4">
    <div class="col-md-8 offset-md-1">
      <h4 class="bg-light px-3 py-2 d-inline-block font-weight-bold mb-4">会員一覧</h4>

      <table class="table">
        <thead class="table-light">
          <tr>
            <th>会員ID</th>
            <th>氏名</th>
            <th>メールアドレス</th>
            <th>ステータス</th>
          </tr>
        </thead>
        <tbody>
          <% @customers.each do |customer| %>
            <tr>
              <td><%= customer.id %></td>
              <td>
                <%= link_to admin_customer_path(customer) do %>
                  <%= customer.last_name %><%= customer.first_name %>
                <% end %>
              </td>
              <td><%= customer.email %></td>
              <td>
                <% if customer.is_active? %>
                  <span class="text-success font-wight-bold">有効</span>
                <% else %>
                  <span class="text-secondary font-wight-bold">退会</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>