<div class="container">
  <div class="row my-4">
    <div class="col-md-10 offset-md-1">
      <h2 class="mb-4">注文履歴詳細</h2>

      <!-- 購入者情報 -->
      <table class="table table-borderless">
        <tr>
          <th style="width: 20%;">購入者</th>
          <td><%= @order.customer.last_name %> <%= @order.customer.first_name %></td>
        </tr>
        <tr>
          <th>注文日</th>
          <td><%= @order.created_at.strftime('%Y-%m-%d') %></td>
        </tr>
        <tr>
          <th>配送先</th>
          <td>〒<%= @order.postal_code %> <%= @order.address %></td>
        </tr>
        <tr>
          <th>支払方法</th>
          <td><%= @order.payment_method %></td>
        </tr>
        <tr>
          <th>注文ステータス</th>
          <td>
            <%= form_with model: @order, url: admin_order_path(@order), method: :patch, local: true do |f| %>
              <%= f.select :status, Order.statuses.keys.map { |k| [Order.new(status: k).status_i18n, k] }, { selected: @order.status }, { class: "form-control-sm mr-2" } %>
              <%= f.submit "更新", class: "btn btn-success btn-sm" %>
            <% end %>
          </td>
        </tr>
      </table>

      <table class="table">
        <thead>
          <tr>
            <th>商品名</th>
            <th>単価（税込）</th>
            <th>数量</th>
            <th>小計</th>
            <th>製作ステータス</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @order.order_details.each do |order_detail| %>
            <tr>
              <td><%= order_detail.item.name %></td>
              <td><%= order_detail.price %></td>
              <td><%= order_detail.amount %></td>
              <td><%= order_detail.price * order_detail.amount %></td>
              <td>
                <%= form_with model: [:admin, order_detail], local: true do |f| %>
                  <%= f.select :making_status, OrderDetail.making_statuses.keys.map { |k| [OrderDetail.new(making_status: k).making_status_i18n, k] }, {}, { class: "form-control-sm mr-2" } %>
                  <%= f.submit "更新", class: "btn btn-success btn-sm" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
