<%= form_with model @order, url: confirm_orders_path, method: :post do |f| %>

    <h3>注文情報入力</h3>

    <h4>支払方法</h4>
    <div>
        <%= f.radio_button %><p>クレジットカード</p><br>
        <%= f.radio_button %><p>銀行振込</p>
    </div>

    <h4>お届け先</h4>
    <div>
        <%= f.radio_button %><p>ご自身の住所</p><br>
        <%= order.current_custemor.addresses %><br>
        <%= order.current_custemor.name %>
    </div>
    <div>
        <%= f.radio_button %><p>登録先住所から選択</p><br>
        <%= f.select  %>
    </div>
    <div>
        <%= f.radio_button %><p>新しいお届け先</p><br>
        <p>郵便番号(ハイフンなし)</p>
        <%= f.postal_code_field :postal_code %><br>
        <p>住所</p>
        <%= f.address_field :address %><br>
        <p>宛名</p>
        <%= f.name_field :name %>
    </div>
    <div>
        <%= f.submit "確認画面に進む", class: "btn btn-info" %>
    </div>
<% end %>