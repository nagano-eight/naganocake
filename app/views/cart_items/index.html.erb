<h3>ショッピングカート</h3>
<div>
    <%= link_to "カートを空にする", class: "btn btn-danger" %>
</div>
<div>
    <table>
        <thead>
            <tr>
                <th>商品名</th>
                <th>単価(税込)</th>
                <th>数量</th>
                <th>小計</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% @items.each do |item| %>
                <tr>
                    <td><%= item.item_name %></td>
                    <td><%= item.price.to_fs(:delimited) %></td>
                    <td>
                        <%= form_with model: cart_item, url: public_cart_item_path(cart_item), method: :path, local: true do |f| %>
                            <%= f.select :amount, options_for_select((1..10).to_a, cart_item.amount), {}, {oncahge: 'this.form.submit();', class: "quantity-select" } do %>
                        <% end %>
                        <% item.submit "変更", class: "btn btn-success" do %>
                    </td>
                    <td><%= items.subtotal.to_fs(:delimited) %></td>
                    <td><%= item.submit "削除する" %></td>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>

<div>
    <%= link_to "買い物を続ける", class: "btn btn-primary" %>
</div>
<div>
    <tr>
        <th>合計金額</th>
        <td>
            <p><%= total.to_fs(delimited) %></p>
        </td>
    </tr>
</div>
<div>
    <%= link_to "情報入力に進む", class: "btn btn-success" %>
</div>