<style>
    .orders-confirm-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px 40px;
    }
    h3 {
        display: inline-block;
        background-color: #ededed;
        margin-left: 80px;
        padding: 0 20px;
    }
    .flex-container {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
    }
    table {
        border-collapse: collapse;
    }
    th {
        background-color: #ededed;
    }
    th, td {
        border: 2px solid #777;
        padding: 5px;
        text-align: left;
    }
    .product-table {
        width: 65%;
    }
    .price-table {
        width: 30%;
    }
    .select-payment {
        margin-bottom: 30px;
    }
    .select-address {
        margin-bottom: 15px;
    }
    .action-area {
        text-align: center;
        margin: 40px auto;
    }
    .custom-btn {
        display: inline-block;
        background-color: transparent;
        color: #ffffff;
        border: none !important;
        font-weight: bold;
        border-radius: 4px;
        cursor: pointer;        
    }
    .btn-green {
        font-size: 16px;
        background-color: #28a745;
        padding: 5px 16px;
    }
    strong {
        padding-right: 20px;
    }
</style>

<div class="orders-confirm-container">
    <h3>注文情報確認</h3>
    <div class="flex-container">
        <table class="product-table">
            <thead>                
                <tr>
                    <th>商品名</th>
                    <th>単価(税込)</th>
                    <th>数量</th>
                    <th>小計</th>
                </tr>                
            </thead>
            <tbody>
                <% @cart_items.each do |cart_item| %>
                    <tr>
                        <td><%= hidden_field :cart_item, value: cart_item.item.name %><%= cart_item.item.name %></td>
                        <td><%= hidden_field :cart_item, value: cart_item.item.with_tax_price %><%= cart_item.item.with_tax_price %></td>
                        <td><%= hidden_field :cart_item, value: cart_item.amount %><%= cart_item.amount %></td>
                        <td><%= hidden_field :cart_item, value: cart_item.subtotal %><%= cart_item.subtotal %></td>
                    </tr>
                <% end %>
            </tbody>
        </table>
        <table class="price-table">
            <tbody>
                <tr>
                    <th>送料</th>
                    <td><%= hidden_field :shipping_cost, value: @order.shipping_cost %><%= @order.shipping_cost %></td>
                </tr>
                <tr>
                    <th>商品合計</th>
                    <td><%= @cart_items.sum(&:subtotal) %></td>
                </tr>
                <tr>
                    <th>請求金額</th>
                    <td><%= @order.total_payment %></td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="select-payment">
        <strong>支払方法</strong>        
        <%= @order.payment_method_i18n %>
    </div>

    <div class="select-address">
        <strong>お届け先</strong>
        <%= form_with model: @order, url: orders_path, method: :post, local: true do |f| %>
            <%= f.hidden_field :postal_code, value: @order.postal_code %>
            <%= f.hidden_field :address, value: @order.address %>
            <%= f.hidden_field :name, value: @order.name %>
            <%= f.hidden_field :shipping_cost, value: @order.shipping_cost %>
            <%= f.hidden_field :total_payment, value: @order.total_payment %>
            <%= f.hidden_field :payment_method, value: @order.payment_method %>
            〒<%= @order.postal_code %>
            <%= @order.address %><br>
            <%= @order.name %>    
            <div class="action-area">
                <%= f.submit "注文を確定する", class: "custom-btn btn-green" %>
            </div>
        <% end %>
    </div>
</div>