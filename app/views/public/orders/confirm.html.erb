<div>
    <h3>注文情報確認</h3>
    <div>
        <table>
            <thead>                
                <tr>
                    <th>商品名</th>
                    <th>単価(税込)</th>
                    <th>数量</th>
                    <th>小計</th>
                </tr>                
            </thead>
            <tbody>
                <% @orders.each do |order| %>
                    <tr>
                        <td><%= order.item.name %></td>
                        <td><%= order.price %></td>
                        <td><%= order.amount %></td>
                        <td><%= order.subtotal %></td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>
    <div>
        <table>
            <tbody>
                <tr>
                    <th>送料</th>
                    <th>商品合計</th>
                    <th>請求金額</th>
                    <td>800</td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
    <div>
        <strong>支払方法</strong>
    </div>

    <div>
        <strong>お届け先</strong>〒
    </div>
    
</div>