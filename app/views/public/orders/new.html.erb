<%= form_with model: @order, url: confirm_orders_path, method: :post do |f| %>

    <h3>注文情報入力</h3>

    <h4>支払方法</h4>
    <div>
        <%= f.radio_button :payment_method, "credit_card" %>
        <%= f.label :payment_method_credit_card, "クレジットカード" %><br>
        <%= f.radio_button :payment_method, "transfer" %>
        <%= f.label :payment_method_transfer, "銀行振込" %>
    </div>

    <h4>お届け先</h4>
    <div>
        <%= f.radio_button :select_address, 0, checked: true %>
        <%= f.label :select_address, 0, "ご自身の住所" %><br>
        〒<%= current_customer.postal_code %><%= f.current_customer.address %><br>
        <%= current_customer.last_name %><%= current_customer.first_name %><br>
        <%= f.radio_button :select_address, 1 %>
        <%= f.label :select_address_1, "登録先住所から選択" %><br>
        <%= f.select :address_id, options_form_collection_for_select(Address.all, :id, :address_display)  %>
        <%= f.radio_button :select_address, 2 %>
        <%= f.label :select_address_2, "新しいお届け先" %><br>
        <%= f.label :postal_code, "郵便番号(ハイフンなし)" %>
        <%= f.text_field :postal_code %><br>
        <%= f.label :address, "住所" %>
        <%= f.text_field :address %><br>
        <%= f.label :name, "宛名" %>
        <%= f.text_field :name %>
    </div>
    <div>
        <%= f.submit "確認画面に進む", class: "custom-btn btn-info" %>
    </div>
<% end %>