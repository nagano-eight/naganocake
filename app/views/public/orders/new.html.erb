<style>
    .orders-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px 40px;
    }
    h3 {
        background-color: transparent;
    }
    .order-input { 
        display: inline-block;
        background-color: #ededed !important;
        padding: 0 20px;
    }
    .action-area {
        text-align: center;
        margin: 2%0px auto;
    }
    .custom-btn {
        background-color: transparent;
        background: none !important;
        color: #ffffff !important;
        font-weight: bold;
        cursor: pointer;
    }
    .btn-blue { background-color: #007bff !important; }
</style>

<div class="orders-container">
    <% form_with model: @order, url: confirm_orders_path, method: :post do |f| %>

        <h3 class="order-input">注文情報入力</h3>

        <h4>支払方法</h4>
        <div>
            <%= f.radio_button :payment_method, Order.payment_methods.key(0) %>
            <%= f.label :payment_method_credit_card, Order.payment_methods_i18n[:credit_card] %><br>
            <%= f.radio_button :payment_method, Order.payment_methods.key(1) %>
            <%= f.label :payment_method_transfer, Order.payment_methods_i18n[:transrer] %>
        </div>

        <h4>お届け先</h4>
        <div>
            <%= f.radio_button :select_address, 0, checked: true %>
            <%= f.label :select_address, "ご自身の住所" %><br>
            〒<%= @ %>
            <%= f.radio_button :select_address, 1 %>
            <%= f.label :select, "登録先住所から選択" %><br>
            <%= f.select :address, options_for_select(Address.all, :id, :address_display) %><br>
            <%= f.radio_button :select_address, 2 %>
            <%= f.label :select_address_2, "新しいお届け先" %><br>
            <%= f.label :postal_code, "郵便番号(ハイフンなし)" %>
            <%= f.text_field :postal_code %><br>
            <%= f.label :address, "住所" %>
            <%= f.text_field :address, maxlength: 72, class: "form-control" %><br>
            <%= f.label :name, "宛名" %>
            <%= f.text_field :name %>
        </div>
        <div class="action-area">
            <%= f.submit "確認画面に進む", class: "custom-btn btn-blue" %>
        </div>
    <% end %>
</div>