<h3>注文履歴詳細</h3>

<div>
    <h4>注文情報</h4>
    <th>注文日</th>
    <th>配達先</th>
    <th>支払方法</th>
    <th>ステータス</th>
    <% @addressess.each do |address| %>
        <td><%= address.created_at %></td>
        <td>
            <%= address.postal_code %>
            <%= address.address %>
            <%= address.name %>
        </td>
        <td><%= address.payment_method %></td>
        <td><%= address.order_status %></td>
    <% end %>
</div>

<div>
    <h4>請求情報</h4>
    <table>
        <tr>
            <th>商品合計</th>
            <th>配送料</th>
            <th>ご請求額</th>
            <% @orders.each do |payment_method| %>
                <td><%= payment_method.price %></td>
                <td><%= payment_method.shipping_cost %></td>
                <td><%= payment_method.total_payment %></td>
            <% end %>
        </tr>
    </table>
</div>

<div>
    <table>
        <thead>
            <th>商品</th>
            <th>単価(税込)</th>
            <th>個数</th>
            <th>小計</th>
        </thead>
        <tbody>
            <% @orders.cart_item.each do |cart_item| %>
                <td><%= cart_item.item_id %></td>
                <td><%= cart_item.price %></td>
                <td><%= cart_item.amount_item_id %></td>
                <td><%= cart_item.subtotal %></td>
            <% end %>
        </tbody>
    </table>
</div>