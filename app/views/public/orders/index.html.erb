<h3>注文履歴一覧</h3>
<div>
    <table>
        <thead>
            <tr>
                <th>注文日</th>
                <th>配送先</th>
                <th>注文商品</th>
                <th>支払金額</th>
                <th>ステータス</th>
                <th>注文履歴</th>
            </tr>
        </thead>
        <tbody>
            <% @orders.each do |order| %>
                <tr>
                    <td><%= order.created_at %></td>
                    <td>
                        <%= order.postal_code %>
                        <%= order.address %>
                        <%= order.name %>
                    </td>
                    <td><%= order.cart_items.current_custemor.id %></td>
                    <td><%= order.total_payment.current_custemor.id %></td>
                    <td><%= order.cart_items.updated_at %></td>
                    <td><%= link_to "表示する", order_path(order_id), class: "btn btn-info" %></td>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>

<div>
    <table>
        <tbody>
            <tr>
                <th>送料</th>
                <th>商品合計</th>
                <th>請求金額</th>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        </tbody>
    </table>
</div>

<div>
    <% @orders.each do |order| %>
        <%= order.label :payment_method, "支払方法" %><%= order.payment_method %>
</div>