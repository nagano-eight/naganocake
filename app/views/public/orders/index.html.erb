<div class="container my-5">
    <div class="row mb-4 mt-5">
        <div class="col-12 offset md-1"></div>
            <h3 class="mb-4 bg-light text-center py-2" style="width: 200px; font-weight: bold; padding: 0">注文履歴一覧</h3>
    </div>
    <div class="row mb-4">
        <table class="table table-bordered mb-0" style="border: 1px solid #000000">
            <style>
                .table th { padding: 15px 5px; !important; :vertical-align: middle; }
            </style>
            <thead>
                <tr>
                    <th style="width: 15%; background-color: #ededed;">注文日</th>
                    <th style="background-color: #ededed;">配送先</th>
                    <th style="background-color: #ededed;">注文商品</th>
                    <th style="background-color: #ededed;">支払金額</th>
                    <th style="background-color: #ededed;">ステータス</th>
                    <th style="background-color: #ededed;">注文詳細</th>
                </tr>
            </thead>
            <tbody>
                <% @orders.each do |order| %>
                    <tr>
                        <td><%= order.created_at.strftime('%Y/%m/%d') %></td>
                        <td>
                            <%= order.postal_code %>
                            <%= order.address %>
                            <%= order.name %>
                        </td>
                        <td>
                          <% order.order_details.each do |order_detail| %>
                            <%= order_detail.item.name %><br>
                          <% end %>
                        </td>
                        <td><%= number_with_delimiter(order.total_payment) %></td>
                        <td><%= order.status_i18n %></td>
                        <td style="width: 8%; white-space: nowrap; vertical-align: middle;"><%= link_to "表示する", order_path(order), class: "btn btn-info", style: "color: #ffffff !important;" %></td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>
</div>