<style>
    .cart-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px 40px;
    }
    .cart-title {
        display: inline-block;
        background-color: #ededed;
        margin-left: 10px;
        margin-bottom: 20px;
        padding: 0 20px;
        font-size: 20px;
    }
    .clear-cart-area {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 15px;
    }
    .custom-btn {
        display: inline-block;
        padding: 6px 16px;
        font-size: 14px;
        font-weight: bold;
        color: #ffffff !import;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }
    .custom-btn,
    .custom-btn input [type="submit"],
    .custom-btn button {
        background-color: transparent;
        background: none !important;
        border: none !important;
        color: #ffffff !important;
        font-weight: bold;
        padding: 5px 10px;
        cursor: pointer;
        text-decoration: none;
    }
    .btn-red {
        background-color: #df4759 !important;
        padding: 5px 10px;
    }
    .btn-blue {
        background-color: #007bff !important;
        padding: 5px 15px;
    }
    .btn-green { 
        font-size: 16px;
        background-color: #28a745 !important;
        padding: 10px 24px;
    }
    .btn-sm { padding: 4px 10px; font-size: 12px; }
    .cart-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        margin-bottom: 20px;
    }
    .cart-table th, .cart-table td {
        border: 1px solid #aaaaaa !important;
        padding: 12px;
        text-align: left;
        vertical-align: middle;
    }
    .cart-table th {
        background-color: #ededed !important;
    }
    .cart-footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-top: 20px;
        margin-bottom: 40px;
    }
    .shopping-to {
        margin-top: 15px;
        margin-left: 25px;
    }
    .price-table {
        border-collapse: collapse;
        min-width: 200px;
    }
    .price-table th, .price-table td {
        padding: 5px 20px;
        white-space: nowrap;
        border: 1px solid #aaaaaa !important;
    }
    .price-table th {
        background-color: #ededed;
    }
    .action-area {
        text-align: center;
        margin-top: 40px;
        margin-bottom: 60px;
    }
</style>
<div class="cart-container">
    <h3 class="cart-title">ショッピングカート</h3>
    <div class="clear-cart-area">
        <%= button_to "カートを空にする", destroy_all_cart_items_path, method: :delete, data: { confirm: "本当に削除しますか？" }, class: "custom-btn btn-red" %>
    </div>
    <div>
        <table class="cart-table">
            <thead>
                <tr>
                    <th>商品名</th>
                    <th style="width: 100px;">単価(税込)</th>
                    <th style="width: 100px;">数量</th>
                    <th style="width: 100px;">小計</th>
                    <th style="width: 100px;"></th>
                </tr>
            </thead>
            <tbody>
                <% @cart_items.each do |cart_item| %>
                    <tr>
                        <td><%= cart_item.item.name %></td>
                        <td style="with: 100px;"><%= cart_item.item.with_tax_price.to_fs(:delimited) if cart_item.item.present? %></td>
                        <td style="width: 100px;">                            
                            <%= form_with model: cart_item, url: cart_item_path(cart_item), method: :patch, local: true do |f| %>
                                <div class="d-flex align-items-center gap-2">
                                    <%= f.select :amount, options_for_select((1..10).to_a, cart_item.amount) %>
                                    <%= f.submit "変更", class: "custom-btn btn-sm btn-green" %>
                                </div>
                            <% end %>
                        </td>
                        <td style="width: 100px;"><%= number_with_delimiter(cart_item.subtotal) if cart_item.respond_to?(:subtotal) %></td>
                        <td style="width: 100px;"><%= link_to "削除する", cart_item_path(cart_item), data: { turbo_method: :delete }, class: "custom-btn btn-red btn-sm" %></td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>

    <div class="cart-footer">
        <div class="shopping-to">
            <%= link_to "買い物を続ける", root_path, class: "custom-btn btn-blue" %>
        </div>
        <div class="price-table">
            <table class="price-table">
                <tbody>
                    <tr>
                        <th>合計金額</th>
                        <td>
                            <p><%= number_with_delimiter(@total_payment) %></p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="action-area">
        <% if @cart_items.present? %>
            <%= link_to "情報入力に進む", new_order_path, class: "custom-btn btn-green" %>
        <% end %>
    </div>
</div>