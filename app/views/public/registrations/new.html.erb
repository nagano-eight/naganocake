<h2>新規会員登録</h2>

<%= form_with model: resource,
              as: resource_name,
              url: registration_path(resource_name),
              local: true do |f| %>

  <div>
    <%= f.label :last_name, "姓" %>
    <%= f.text_field :last_name %>

    <%= f.label :first_name, "名" %>
    <%= f.text_field :first_name %>
  </div>

  <div>
    <%= f.label :last_name_kana, "セイ" %>
    <%= f.text_field :last_name_kana %>

    <%= f.label :first_name_kana, "メイ" %>
    <%= f.text_field :first_name_kana %>
  </div>

  <div>
    <%= f.label :postal_code, "郵便番号" %>
    <%= f.text_field :postal_code %>
  </div>

  <div>
    <%= f.label :address, "住所" %>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :telephone_number, "電話番号" %>
    <%= f.text_field :telephone_number %>
  </div>

  <div>
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password %>
  </div>

  <div>
    <%= f.label :password_confirmation, "パスワード確認" %>
    <%= f.password_field :password_confirmation %>
  </div>

  <div>
    <%= f.submit "新規登録" %>
  </div>

<% end %>