<div class="container mt-4">
  <div class="row">

    <!-- 左：ジャンル検索 -->
    <div class="col-md-3">
      <h4>ジャンル検索</h4>

      <% @genres.each do |genre| %>
        <div>
          <%= link_to genre.name, items_path(genre_id: genre.id) %>
        </div>
      <% end %>
    </div>

    <!-- 中央：商品画像 -->
    <div class="col-md-4">
      <% if @item.image.attached? %>
        <%= image_tag @item.image, class: "img-fluid" %>
      <% end %>
    </div>

    <!-- 右：商品情報 -->
    <div class="col-md-5">
      <h3><%= @item.name %></h3>

      <p><%= @item.introduction %></p>

      <h4>
        <%= @item.with_tax_price %>円（税込）
      </h4>

      <%= form_with model: CartItem.new, url: cart_items_path, local: true do |f| %>
        <%= f.hidden_field :item_id, value: @item.id %>

        <div class="mt-4">
          <%= f.select :amount, (1..10).to_a, prompt: "個数選択" %>
          <%= f.submit "カートに入れる", class: "btn btn-success ml-3" %>
        </div>
      <% end %>
    </div>

  </div>
</div>