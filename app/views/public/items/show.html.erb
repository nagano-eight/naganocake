<div>
  <h3>ジャンル検索</h3>

  <% @genres.each do |genre| %>
    <div>
      <%= link_to genre.name, items_path(genre_id: genre.id) %>
    </div>
  <% end %>
</div>

<h2>商品詳細</h2>

<div>
  <% if @item.image.attached? %>
    <%= image_tag @item.image, size: "300x200" %>
  <% end %>

  <p>商品名：<%= @item.name %></p>
  <p>商品説明：<%= @item.introduction %></p>
  <p>価格：<%= @item.with_tax_price %>円（税込）</p>
</div>

<%= form_with model: CartItem.new, url: cart_items_path, local: true do |f| %>
  <%= f.hidden_field :item_id, value: @item.id %>

  <div>
    <%= f.select :amount, (1..10).to_a, prompt: "個数選択" %>
    <%= f.submit "カートに入れる" %>
  </div>
<% end %>