<div class="container mt-4">
  <div class="row">

    <!-- 左側：ジャンル検索 -->
    <div class="col-md-3">
      <h4>ジャンル検索</h4>

      <% @genres.each do |genre| %>
        <div>
          <%= link_to genre.name, items_path(genre_id: genre.id) %>
        </div>
      <% end %>
    </div>

    <!-- 右側：商品一覧 -->
    <div class="col-md-9">
      <% if @genre.present? %>
        <h2><%= @genre.name %>一覧（全<%= @items.count %>件）</h2>
      <% else %>
        <h2>商品一覧（全<%= @items.count %>件）</h2>
      <% end %>

      <div class="row">
        <% @items.each do |item| %>
          <div class="col-md-3 mb-4">

            <% if item.image.attached? %>
              <%= link_to item_path(item) do %>
                <%= image_tag item.image, class: "img-fluid" %>
              <% end %>
            <% end %>

            <div>
              <%= item.name %>
            </div>

            <div>
              <%= item.with_tax_price %>円（税込み）
            </div>

          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>